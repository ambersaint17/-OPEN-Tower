{
  "name": "tower-discord-bot",
  "version": "2.0.0",
  "private": false,
  "description": "Tower: an open-source, self-hosted Discord bot for verification, moderation, tickets, levels, giveaways, logging and more. Built on discord.js 14 and Components V2.",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "start:lowmem": "node --max-old-space-size=192 --optimize-for-size src/index.js",
    "deploy": "node src/deploy-commands.js",
    "test": "node --require ./test/env.js --test"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@napi-rs/canvas": "^0.1.0",
    "discord.js": "^14.19.0",
    "dotenv": "^16.0.0",
    "postgres": "^3.4.0"
  },
  "license": "MIT",
  "keywords": [
    "discord",
    "discord-bot",
    "discord.js",
    "moderation",
    "tickets",
    "levels",
    "giveaways",
    "supabase",
    "components-v2"
  ]
}
