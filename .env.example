# Copy this file to .env (when running on your own computer) or set the same names in your host's
# "Environment variables" panel. NEVER commit real values or share them: anyone with your token controls your bot.

# ---------- Required ----------
# Discord Developer Portal -> your application -> Bot -> Reset Token
DISCORD_TOKEN=
# Discord Developer Portal -> your application -> General Information -> Application ID
CLIENT_ID=
# Supabase -> your project -> Connect -> Session pooler connection string (see the README, step 3).
# If the password has special characters (@ : / # ? or spaces) it must be URL-encoded.
DATABASE_URL=
# Any long random string, used to protect captcha answers. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CAPTCHA_SECRET=

# ---------- Optional ----------
# Your test server's ID. Slash commands then update instantly there. Leave empty to register them everywhere.
GUILD_ID=
# Name (and optional custom emoji) shown in the footer of every card.
BOT_NAME=Tower
BRAND_EMOJI=
# Channel where finished commission reviews are posted. Or just make a channel called "commission-reviews".
COMMISSION_REVIEW_CHANNEL_ID=

# AI assistant (/ask, /ai). Leave empty to keep it off. The provider is detected from the key:
#   sk-or-...   OpenRouter (openrouter.ai, has free models)
#   sk-ant-...  Anthropic (console.anthropic.com)
AI_API_KEY=
# The exact model to use. On OpenRouter, models ending in :free cost nothing. Defaults to openrouter/auto there.
AI_MODEL=
# Force a provider: anthropic | openrouter | openai. Normally detected from the key, so you can leave this empty.
AI_PROVIDER=
# Only for other OpenAI-compatible services (Groq, Google Gemini, a local server...): their base URL.
AI_BASE_URL=

# ---------- Low-memory tuning (all optional) ----------
# Messages remembered in memory so deleted and edited text can be logged. Lower it on tiny hosts. Default 1500.
MESSAGE_CACHE_MAX=1500
# Captcha images drawn ahead of time per difficulty. 0 = draw on demand (least memory). Default 2.
CAPTCHA_POOL_SIZE=2
# Database connections. Default 3.
DB_POOL_MAX=3
# Set automatically by hosts that run bots as web services. Tower then answers a tiny health check on this port.
PORT=
# Folder with your own banner images (see assets/images/README.md). Defaults to assets/images.
BANNER_DIR=
# Path to a custom config file. Defaults to tower.config.json in the project folder.
TOWER_CONFIG=
